# Courtesy Environment Configuration Template
# Copy this file to .env to configure local or deployment overrides.
# NOTE: .env is gitignored and will never be committed.

# Administrative Access Credentials
COURTESY_ADMIN_USER=admin
COURTESY_ADMIN_PASSWORD=your_admin_password_here
COURTESY_SALT=courtesy_secret_salt_v2

# Optional SSH Password Fallback for Cluster Nodes (default: uses SSH keys)
COURTESY_SSH_PASS=your_ssh_pass_here

# Gateway Service Port & Host
COURTESY_PORT=8000
COURTESY_HOST=0.0.0.0
