# Courtesy Environment Configuration Template
# Copy this file to .env to configure local or deployment overrides.
# NOTE: .env is gitignored and will never be committed.

# ================= Security & Administrative Credentials =================
COURTESY_ADMIN_USER=admin
COURTESY_ADMIN_PASSWORD=your_strong_admin_password_here
COURTESY_SALT=courtesy_secret_salt_v2

# ================= Cluster SSH Credentials =================
# Optional SSH Password Fallback for Cluster Nodes (default: uses SSH keys)
COURTESY_SSH_PASS=your_ssh_pass_here

# ================= Network & Service Binding =================
COURTESY_PORT=8000
COURTESY_HOST=0.0.0.0

# ================= Public Deployment & Access Hardening =================
# Restrict CORS origins (comma-separated). Set to specific origins when exposing to the public:
# COURTESY_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://100.107.249.92:8000
COURTESY_ALLOWED_ORIGINS=*

# API Rate Limiter: Max requests per minute per IP address (default: 180)
COURTESY_RATE_LIMIT_RPM=180

# Workspace Security Sandbox Root: Confine all workspace file operations to this directory tree
# (If unset, defaults to the project workspace directory)
# COURTESY_WORKSPACE_ROOT=/home/cst/projects

# Remote Execution Protection:
# Set to 'false' to completely disable server-side arbitrary command execution (POST /api/workspace/exec)
COURTESY_ALLOW_WORKSPACE_EXEC=true
